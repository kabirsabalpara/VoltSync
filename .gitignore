# VoltSync — Root .gitignore
# Covers both backend and frontend monorepo architecture

# ==========================================
# 1. Dependency Directories
# ==========================================
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp/
.pnp.js

# ==========================================
# 2. Environment Variables & Secret Credentials
# (CRITICAL: Never commit real database URIs or JWT secrets)
# ==========================================
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local
backend/.env
frontend/.env
frontend/.env.local

# Allow example template files to be tracked
!.env.example
!backend/.env.example
!frontend/.env.example

# ==========================================
# 3. Production Builds & Compiled Bundles
# ==========================================
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
build/
out/

# ==========================================
# 4. Binary Archives & Backup Artifacts
# ==========================================
voltsync_project.zip
*.zip
*.tar.gz
*.tgz
*.rar

# ==========================================
# 5. Logs & Runtime Debug Traces
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# 6. Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ==========================================
# 7. IDE & Editor Metadata
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ==========================================
# 8. Testing & Code Quality Cache
# ==========================================
coverage/
.nyc_output/
.eslintcache
.stylelintcache
