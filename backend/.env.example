# VoltSync Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/ev_charging

# JWT Secret for authentication tokens (Minimum 32 random characters in production)
JWT_SECRET=voltsync_super_secret_jwt_key_development_only_change_in_prod

# Payment Gateway Configuration
# Mode: "mock" (development only - controlled sandbox) or "razorpay" (real HMAC-verified orders)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# CORS Configuration: Comma-separated list of exact allowed origins (no trailing slashes)
# In development, localhost origins are allowed; in production, only explicitly listed origins are permitted
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
