# VoltSync Frontend Environment Configuration

# Backend API Base URL
VITE_API_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000/api

# Google Maps Platform API Key
# NOTE: Set this key to enable full Google Maps Cyber styling, dynamic route polylines, and Places autocomplete.
# If omitted or missing, VoltSync automatically falls back seamlessly to Leaflet OpenStreetMap.
# SECURITY BEST PRACTICE: Restrict this key in the Google Cloud Console using "HTTP Referrers (web sites)"
# restrictions to your domain (e.g. http://localhost:5173/*, https://your-domain.vercel.app/*)
# and restrict API scope to "Maps JavaScript API" and "Places API".
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY

# Payment Gateway Configuration
# When PAYMENT_MODE=mock (default demo mode), NO keys are needed.
# Optional only if Razorpay live mode is explicitly enabled:
# VITE_RAZORPAY_KEY_ID=

